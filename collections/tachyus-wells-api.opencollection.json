{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tachapps Production Data Wells API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
